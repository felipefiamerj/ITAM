DJANGO_ENV=production
DEBUG=False
SECRET_KEY=<gere-uma-chave-longa-com-python-secrets-token-urlsafe-64>
APP_NAME=FIAME System
APP_SHORT_NAME=FIAME
APP_STATIC_VERSION=20260817-2fa
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10
BACKUP_DIR=backups
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin

ALLOWED_HOSTS=itam.seu-dominio.com
SITE_URL=https://itam.seu-dominio.com
ITAM_QR_BASE_URL=https://itam.seu-dominio.com
ITAM_SLA_ETAPA_MINUTOS=solicitado:240,triagem:240,aguardando_estoque:1440,aguardando_aprovacao:1440,aprovado_para_retirada:480,em_separacao:480,pronto_para_entrega:480
ITAM_SLA_ETAPA_ALERTA_PERCENTUAL=75
ITAM_TERMO_ASSINATURA_VALIDADE_DIAS=7
ITAM_TERMO_ASSINATURA_COBRANCA_AUTOMATICA=True
ITAM_TERMO_ASSINATURA_COBRANCA_INTERVALO_DIAS=1
ITAM_TERMO_ASSINATURA_COBRANCA_HORA=8
ITAM_TERMO_ASSINATURA_COBRANCA_MINUTO=0
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False

DB_ENGINE=django.db.backends.postgresql
# DATABASE_URL=postgresql://itam:<senha-forte-do-banco>@127.0.0.1:5432/itam
DB_NAME=itam
DB_USER=itam
DB_PASSWORD=<senha-forte-do-banco>
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=<usuario-smtp>
EMAIL_HOST_PASSWORD=<senha-smtp>
DEFAULT_FROM_EMAIL=FIAME System <noreply@seu-dominio.com>
ITAM_ADMIN_EMAILS=suporte@seu-dominio.com
ITAM_CORPORATE_WEBHOOKS_ENABLED=False
ITAM_TEAMS_WEBHOOK_URL=
ITAM_SLACK_WEBHOOK_URL=
ITAM_WEBHOOK_TIMEOUT_SECONDS=5

ITAM_API_SERVICE_MATRICULA=
ITAM_API_SHARED_KEY=
ITAM_API_SHARED_KEY_SHA256=
ITAM_API_AUTH_RATE_LIMIT=30/m
ITAM_API_REQUEST_RATE_LIMIT=120/m
ITAM_ADMIN_2FA_REQUIRED=True
ITAM_TWO_FACTOR_ENCRYPTION_KEY=troque-por-um-segredo-longo-e-aleatorio
ITAM_TWO_FACTOR_ISSUER=FIAME System
ITAM_TWO_FACTOR_VALID_WINDOW=1
ITAM_TWO_FACTOR_TRUST_DAYS=30
# IPs/CIDRs abaixo ignoram apenas o rate limit; nao recebem privilegios de autenticacao.
ITAM_RATE_LIMIT_BYPASS_IPS=
# Preencha apenas com proxies que sobrescrevem X-Forwarded-For recebido do cliente.
ITAM_TRUSTED_PROXY_IPS=
ITAM_ESTOQUE_ALERTA_MINIMO=5
ITAM_RESERVA_INTELIGENTE_SCORE_MINIMO=70

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
